{
	"name": "frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "rimraf -g \"../public/{script,style}/*.br\"",
		"dev": "pnpm run /^dev:.*/",
		"dev:css": "postcss css/*.css --base css -d ../public/style -w",
		"dev:js": "rollup -c -w --environment build:development",
		"dev:static": "node build/src/static.ts -s static -d ../public --svgoConfig svgo.config.js -w",
		"prebuild": "rimraf -g \"../public/{script,style}/*\"",
		"build": "pnpm run /^build:.*/",
		"build:css": "postcss css/*.css --base css -d ../public/style",
		"build:js": "rollup -c --environment build:production",
		"build:static": "node build/src/static.ts -s static -d ../public --svgoConfig svgo.config.js",
		"postbuild": "prettier --config ../.prettierrc.mjs -w \"../public/script/*.{js,mjs}\" \"../public/style/*.css\" && brotli-cli compress -g \"../public/.well-known/*.json\" \"../public/script/*.{js,mjs}\" \"../public/style/*.css\" \"../public/image/**/*.svg\" \"../public/*.svg\" \"../public/favicon.ico\" -m text",
		"test": "node --experimental-test-coverage --test javascript/src/**/*.test.ts"
	},
	"dependencies": {
		"@w0s/base.css": "1.4.0",
		"@w0s/button-clipboard": "3.0.7",
		"@w0s/file-size-format": "4.0.1",
		"@w0s/footnote-reference-popover": "7.4.0",
		"@w0s/form-before-unload-confirm": "3.0.3",
		"@w0s/form-submit-overlay": "4.0.5",
		"@w0s/html-escape": "5.0.0",
		"@w0s/input-file-preview": "3.0.7",
		"@w0s/paapi-item-image-url-parser": "4.0.0",
		"@w0s/report-js-error": "4.0.2",
		"@w0s/report-same-referrer": "5.0.1",
		"@w0s/string-convert": "4.0.0",
		"@w0s/tab": "5.0.3",
		"chokidar": "5.0.0",
		"slash": "5.1.0",
		"svgo": "4.0.2"
	},
	"devDependencies": {
		"@csstools/postcss-global-data": "4.0.0",
		"@rollup/plugin-commonjs": "29.0.3",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-sucrase": "^5.1.0",
		"@types/jsdom": "30.0.0",
		"@types/trusted-types": "2.0.7",
		"brotli-cli": "2.1.1",
		"jsdom": "30.0.1",
		"postcss": "8.5.26",
		"postcss-cli": "11.0.1",
		"postcss-custom-media": "12.0.1",
		"postcss-discard-comments": "8.0.2",
		"postcss-discard-empty": "8.0.2",
		"postcss-import": "16.1.1",
		"postcss-nesting": "14.0.1",
		"rollup": "4.62.4"
	},
	"packageManager": "pnpm@11.8.0"
}
